<div class="banner" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url(https://images.pexels.com/photos/7991437/pexels-photo-7991437.jpeg);">
  <div class="container">
    <h1>The Movie Lister</h1>
    <p>From watch lists to favorites, organize movies your own way!</p>
  </div>
</div>
<div class="container">
  <h1>Here's the list</h1>
  <div class="cards">
    <% @lists.each do |list| %>
      <%= link_to list_path(list), class: 'text-white text-decoration-none' do %>
        <div class="card-category" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url(<%= list.photo.attached? ? cl_image_path(list.photo.key) : 'https://happiclap.com/wp-content/uploads/2019/06/Everyday-Clapboard-1.jpg' %>)">
          <%= list.name %>
        </div>
      <% end %>
    <% end %>
  </div>
  <%= link_to "Add a List", new_list_path(@lists) %>
</div>
